# Copy to .env and fill in. .env is gitignored -- never commit real values.
# Only EMAIL / EMAIL_PASSWORD are needed to actually send; the rest have
# working defaults (see src/email_sender/notifier.py).

# SMTP account the reports are sent from.
EMAIL=
EMAIL_PASSWORD=

# Mail server. Defaults suit a STARTTLS server on the submission port.
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Who the reports go to. Comma-separated for more than one recipient.
CLIENT_TO=client@example.com
FROM_ADDR=sitewatch@example.com

# Site name shown in the subject line and report header.
SITE_NAME=example.edu.au
