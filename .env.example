# Copy to .env and fill in. .env is gitignored -- never commit real values.
# app/core/config.py reads this file for the whole project, so there is no need
# to `source` it. Anything already exported wins over what's in here.

# Nothing is actually emailed until this is false. Leave it alone unless you
# are deliberately testing real delivery -- see the README.
DRY_RUN=true

# The account the reports are sent from.
# Gmail: this is your address, and EMAIL_PASSWORD is a 16 character App
# Password (Google account -> Security -> 2-Step Verification -> App
# passwords). Your normal login will not work.
EMAIL=
EMAIL_PASSWORD=

# Mail server. Defaults suit a STARTTLS server on the submission port.
# Gmail: smtp.gmail.com / 587
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Who the reports go to. Comma-separated for more than one recipient.
# Point this at your own address while testing.
CLIENT_TO=client@example.com

# Gmail rewrites this to the authenticated account anyway, so set it to the
# same address as EMAIL.
FROM_ADDR=sitewatch@example.com

# Fallback site name for the subject line and report header. Once websites are
# in the database each report is stamped with that site's own URL instead, so
# this only shows up in the demo and the send test.
SITE_NAME=example.edu.au

# Timezone the report times are shown in. The client reads these, so it should
# be their timezone, not the server's. Any IANA name works (Australia/Perth,
# UTC, ...); an unknown one falls back to UTC with a warning.
REPORT_TIMEZONE=Australia/Perth

# Wall clock time of the daily notification run, in REPORT_TIMEZONE. The
# scheduler runs against the clock rather than every N seconds, so the report
# does not drift later each day.
DAILY_RUN_HOUR=6
DAILY_RUN_MINUTE=0

# How often the scrape loop runs, once the scraper exists. Seconds.
SCRAPE_INTERVAL_SECONDS=3600

# A send that fails is parked and retried with an exponential backoff starting
# at RETRY_BASE_DELAY_SECONDS, never waiting longer than RETRY_MAX_DELAY_SECONDS,
# and given up on loudly after RETRY_MAX_ATTEMPTS tries.
RETRY_BASE_DELAY_SECONDS=900
RETRY_MAX_DELAY_SECONDS=86400
RETRY_MAX_ATTEMPTS=5

# Database credentials (used by the app/db layer).
DB_USER=
DB_PASSWORD=
