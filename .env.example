# Copy to .env and fill in. .env is gitignored -- never commit real values.
# notifier.py reads this file itself, so there is no need to `source` it.
# Anything already exported wins over what's in here.

# Nothing is actually emailed until this is false. Leave it alone unless you
# are deliberately testing real delivery -- see the README.
DRY_RUN=true

# The account the reports are sent from.
# Gmail: this is your address, and EMAIL_PASSWORD is a 16 character App
# Password (Google account -> Security -> 2-Step Verification -> App
# passwords). Your normal login will not work.
EMAIL=
EMAIL_PASSWORD=

# Mail server. Defaults suit a STARTTLS server on the submission port.
# Gmail: smtp.gmail.com / 587
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# Who the reports go to. Comma-separated for more than one recipient.
# Point this at your own address while testing.
CLIENT_TO=client@example.com

# Gmail rewrites this to the authenticated account anyway, so set it to the
# same address as EMAIL.
FROM_ADDR=sitewatch@example.com

# Site name shown in the subject line and report header.
SITE_NAME=example.edu.au
